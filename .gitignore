# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/

# agent scaffolding: kept locally, never shipped (skills, rules, memory bank, agent entry files)
/.cline/
/.clinerules/
/memory-bank/
/AGENTS.md
/CLAUDE.md

# i18n exports (generated by db/i18n/export-*.mjs, may contain data read from the production database)
/db/i18n/*.new.tsv
/prod-*.tsv

# local production backups / exports (pg_dump, prod TSV dumps) — never commit data dumps
/.backups/
