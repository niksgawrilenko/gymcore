# Скопируй в .env.local и заполни. На Vercel эти же переменные задаются в Settings → Environment Variables.

# PostgreSQL.
#   Локально: postgres://postgres:пароль@localhost:5432/gymcore
#   Neon:     pooled-строка из консоли (хост с "-pooler"), например
#             postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gymcore

# Подпись сессионных cookie. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Cloudinary (фото/видео тренировок). Без них приложение работает, только загрузка медиа будет недоступна.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
