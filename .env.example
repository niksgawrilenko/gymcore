# Скопируй в .env.local и заполни. На Vercel эти же переменные задаются в Settings → Environment Variables.

# PostgreSQL.
#   Локально: postgres://postgres:пароль@localhost:5432/gymcore
#   Neon:     pooled-строка из консоли (хост с "-pooler"), например
#             postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gymcore

# Разовые операции против прод-БД (npm run db:setup, db:i18n:*): держите строку в отдельном
# локальном файле .env.prod.local (он под .env* в .gitignore). Переменные окружения перекрывают
# .env.local, поэтому локальная база при таких запусках не затрагивается, а .env.local править не нужно.
#   $env:DATABASE_URL = (node -e "process.stdout.write(require('dotenv').parse(require('fs').readFileSync('.env.prod.local','utf8')).DATABASE_URL)")
# Записи в не-локальную базу скрипты требуют флага --yes; сначала всегда --dry-run.

# Подпись сессионных cookie. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Cloudinary (фото/видео тренировок). Без них приложение работает, только загрузка медиа будет недоступна.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Публичный адрес сайта — абсолютные ссылки в метаданных, robots.txt, sitemap.
# Пусто = домен Vercel (VERCEL_PROJECT_PRODUCTION_URL), локально = http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Включённые локали через запятую (по умолчанию en,ru). Например `en` для одноязычного деплоя.
NEXT_PUBLIC_LOCALES=

# Подтверждение владения сайтом для поисковых систем — значения попадут в <meta> теги автоматически.
# Берутся из консолей: Search Console (google-site-verification), Яндекс.Вебмастер (yandex-verification),
# Bing Webmaster Tools (msvalidate.01). Пусто = тег не выводится. Альтернатива — DNS TXT-запись.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
BING_SITE_VERIFICATION=
